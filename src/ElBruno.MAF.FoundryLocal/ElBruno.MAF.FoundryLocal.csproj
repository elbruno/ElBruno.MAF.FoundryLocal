<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>ElBruno.MAF.FoundryLocal.Adapter</PackageId>
    <Version>0.5.0</Version>
    <PackageReleaseNotes>Native Foundry Local chat, streaming, and embedding sessions; token usage reporting; and explicit rejection of unsupported named-tool selection. See the repository changelog for migration notes.</PackageReleaseNotes>
    <Authors>El Bruno</Authors>
    <Description>Foundry Local adapters for Microsoft.Extensions.AI IChatClient, embeddings, and typed decision models.</Description>
    <PackageTags>foundry-local;agent-framework;microsoft-extensions-ai;chatclient;adapter;decision;kev</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>repo-icon.png</PackageIcon>
    <PackageReadmeFile>README.Package.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/elbruno/ElBruno.MAF.FoundryLocal</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://github.com/elbruno/ElBruno.MAF.FoundryLocal</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.Package.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\images\repo-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ElBruno.MAF.FoundryLocal.Tests" />
    <PackageReference Include="Microsoft.AI.Foundry.Local" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0" />
  </ItemGroup>

</Project>
